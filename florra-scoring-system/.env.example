# ─────────────────────────────────────────────────
# Florra Scoring System — Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Airtable Personal Access Token (PAT)
# Get from: https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write,
#                  schema.bases:read, schema.bases:write
AIRTABLE_PAT=patXXXXXXXXXXXXXXXX

# Airtable Base ID (do not change for Florra CRM)
AIRTABLE_BASE_ID=applXEAjh6k3Xmybl

# Table IDs — pre-configured for Florra CRM
PEOPLE_TABLE_ID=tblvkCqhZRjOjFYlT
OUTREACH_TABLE_ID=tbldNGQfKwQEq4yAo
BRAND_TARGETS_TABLE_ID=tblWNJdX1WrYFAZyN
CAMPAIGNS_TABLE_ID=tblvbY12bVp1yudmp

# Script behavior
# Set to "true" to print actions without writing to Airtable
DRY_RUN=false

# Rate limiting — requests per second (Airtable limit: 5/sec per base)
RATE_LIMIT_RPS=4

# Batch size for backfill script (max 10 per Airtable update call)
BACKFILL_BATCH_SIZE=10
