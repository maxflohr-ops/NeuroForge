# ── Ridge Club YouTube Archiver ─────────────────────────────────
# Copy to .env and fill in.

# Ridge Club house channel (handle, /channel/UC..., or /c/... URL all work)
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@RidgeClub

# The shared "Ridge Club YouTube" Google Drive folder
# (from https://drive.google.com/drive/folders/<ID>)
DRIVE_ROOT_FOLDER_ID=

# Google service account key (share the Drive folder with this account's email)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# OpusClip
OPUS_ENABLED=true
OPUS_API_KEY=
# OPUS_API_BASE=https://api.opus.pro/api

# Optional tuning
# DOWNLOAD_DIR=downloads
# WATCH_INTERVAL_MINUTES=15
# MAX_VIDEO_HEIGHT=1080
# KEEP_LOCAL_FILES=false
# YTDLP_COOKIES_FILE=credentials/cookies.txt
