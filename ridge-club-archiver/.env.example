# ── Ridge Club YouTube Archiver ─────────────────────────────────
# Copy to .env and fill in.

# Ridge Club house channel (handle, /channel/UC..., or /c/... URL all work)
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@RidgeClub

# The shared "Ridge Club YouTube" Google Drive folder
# (from https://drive.google.com/drive/folders/<ID>)
DRIVE_ROOT_FOLDER_ID=

# Google service account key (share the Drive folder with this account's email)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# OpusClip
OPUS_ENABLED=true
OPUS_API_KEY=
# OPUS_API_BASE=https://api.opus.pro/api

# Ayrshare — auto-post Opus clips to the linked socials (IG + Snapchat).
# Posting turns on automatically when the key is set; AYRSHARE_ENABLED=false to pause.
AYRSHARE_API_KEY=
# AYRSHARE_PLATFORMS=instagram,snapchat
# AYRSHARE_MAX_CLIPS_PER_VIDEO=3      # top N clips per video; 0 = post all
# AYRSHARE_CAPTION_SUFFIX=#RidgeClub
# AYRSHARE_PROFILE_KEY=               # only for Ayrshare multi-profile accounts
# AYRSHARE_ENABLED=true

# X (Twitter) posting — bring-your-own-keys from your X developer app
# ("Keys and tokens" → API Key / Consumer Key + Secret). Setting these
# automatically adds twitter to the default platforms.
X_TWITTER_OAUTH1_API_KEY=
X_TWITTER_OAUTH1_API_SECRET=

# Optional tuning
# DOWNLOAD_DIR=downloads
# WATCH_INTERVAL_MINUTES=15
# MAX_VIDEO_HEIGHT=1080
# KEEP_LOCAL_FILES=false
# YTDLP_COOKIES_FILE=credentials/cookies.txt
