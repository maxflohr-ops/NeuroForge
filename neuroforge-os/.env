# NeuroForge OS — Environment Variables
# IMPORTANT: Replace all PLACEHOLDER values with your actual API keys
# Never commit real secrets to GitHub

# ── Anthropic (required for pipeline) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-PLACEHOLDER_REPLACE_WITH_YOUR_KEY

# ── HeyGen (required for video production) ─────────────────────
HEYGEN_API_KEY=PLACEHOLDER_REPLACE_WITH_YOUR_KEY

# Avatar IDs — fill in after running heygen-setup
HEYGEN_AVATAR_ID_DR_NOVA_VALE=
HEYGEN_VOICE_ID_DR_NOVA_VALE=

HEYGEN_AVATAR_ID_KAI_REN=
HEYGEN_VOICE_ID_KAI_REN=

HEYGEN_AVATAR_ID_MARCUS_VOSS=
HEYGEN_VOICE_ID_MARCUS_VOSS=

HEYGEN_AVATAR_ID_LUNA_HART=
HEYGEN_VOICE_ID_LUNA_HART=

HEYGEN_AVATAR_ID_DR_ORION_HALE=
HEYGEN_VOICE_ID_DR_ORION_HALE=

# ── Airtable (required for syncing content) ──────────────────
AIRTABLE_API_KEY=PLACEHOLDER_REPLACE_WITH_YOUR_KEY
AIRTABLE_BASE_ID=applXEAjh6k3Xmybl

# ── Flowstage (optional for auto-posting) ─────────────────────
FLOWSTAGE_WEBHOOK_URL=https://api.flowstage.io/webhooks
FLOWSTAGE_API_TOKEN=PLACEHOLDER_REPLACE_WITH_YOUR_KEY

# ── Meta Ads API (for custom audiences) ───────────────────────
META_ADS_ACCESS_TOKEN=PLACEHOLDER_REPLACE_WITH_YOUR_KEY
META_AD_ACCOUNT_ID=PLACEHOLDER_REPLACE_WITH_YOUR_ID

# ── TikTok Ads API (for sound retargeting) ────────────────────
TIKTOK_ADS_ACCESS_TOKEN=PLACEHOLDER_REPLACE_WITH_YOUR_KEY
TIKTOK_ADVERTISER_ID=PLACEHOLDER_REPLACE_WITH_YOUR_ID

# ── Opus API (for podcast clipping) ───────────────────────────
OPUS_API_KEY=PLACEHOLDER_REPLACE_WITH_YOUR_KEY

# ── OpenClaw (Telegram bot) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=PLACEHOLDER_REPLACE_WITH_YOUR_TOKEN
OPENAI_API_KEY=PLACEHOLDER_REPLACE_WITH_YOUR_KEY
BRAVE_API_KEY=PLACEHOLDER_REPLACE_WITH_YOUR_KEY
GATEWAY_MODE=local
GATEWAY_PORT=18789
GATEWAY_HOST=0.0.0.0

# ── Cobalt (for video downloads) ──────────────────────────────
COBALT_URL=http://localhost:9000
