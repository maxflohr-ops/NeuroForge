# NeuroForge OS — Environment Variables
# Copy to .env and fill in your keys:
#   cp .env.example .env

# ── Anthropic (required for pipeline) ──────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── HeyGen (required for video production) ─────────────────────
HEYGEN_API_KEY=your_heygen_key_here

# Avatar IDs — fill in after running heygen-setup
HEYGEN_AVATAR_ID_DR_NOVA_VALE=
HEYGEN_VOICE_ID_DR_NOVA_VALE=

HEYGEN_AVATAR_ID_KAI_REN=
HEYGEN_VOICE_ID_KAI_REN=

HEYGEN_AVATAR_ID_MARCUS_VOSS=
HEYGEN_VOICE_ID_MARCUS_VOSS=

HEYGEN_AVATAR_ID_LUNA_HART=
HEYGEN_VOICE_ID_LUNA_HART=

HEYGEN_AVATAR_ID_DR_ORION_HALE=
HEYGEN_VOICE_ID_DR_ORION_HALE=

# ── TikTok (required for tiktok-publisher) ─────────────────────
# One-time OAuth setup:
#   1. Create an app at https://developers.tiktok.com
#   2. Enable the Content Posting API and request video.publish scope
#   3. Run the OAuth flow (browser redirect) to get your first tokens:
#        https://www.tiktok.com/v2/auth/authorize/
#          ?client_key=YOUR_KEY
#          &scope=video.publish
#          &response_type=code
#          &redirect_uri=YOUR_REDIRECT_URI
#          &state=random_csrf_token
#   4. Exchange the code at POST https://open.tiktokapis.com/v2/oauth/token/
#   5. Paste the returned values below

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=       # expires every 24h — auto-refreshed by publisher
TIKTOK_REFRESH_TOKEN=      # expires in 365 days
TIKTOK_OPEN_ID=            # the creator account's open_id from the token response
